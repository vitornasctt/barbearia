<%# src/views/admin/login.ejs %>
<div class="admin-login" x-data="adminLogin()">
  <h1>Painel — entrar</h1>
  <p class="erro-inline" x-show="erro" x-text="erro"></p>
  <label>E-mail <input type="email" x-model="email"></label>
  <label>Senha <input type="password" x-model="senha"></label>
  <button class="btn-primario" @click="entrar()">Entrar</button>
</div>
