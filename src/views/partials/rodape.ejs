<%# src/views/partials/rodape.ejs %>
<%
  const temCfg = typeof configuracao !== 'undefined' && configuracao;
  const nomeBarbearia = temCfg ? configuracao.nome_barbearia : 'Barbearia';
  const telWaRodape = temCfg && configuracao.telefone_whatsapp
    ? String(configuracao.telefone_whatsapp).replace(/\D/g, '') : '';
%>
<footer class="rodape">
  <div class="envoltorio rodape-grid">
    <div>
      <div class="rodape-marca">
        <img src="/img/logo.svg" alt="" class="logo">
        <span><%= nomeBarbearia %></span>
      </div>
      <p>Corte, barba e cuidado com hora marcada.<br>Tradição e acabamento em cada visita.</p>
      <div class="redes">
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24"><path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg>
        </a>
        <% if (telWaRodape) { %>
        <a href="https://wa.me/<%= telWaRodape %>" target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24"><path d="M21 15.5a2 2 0 0 1-2 2A16 16 0 0 1 4 3a2 2 0 0 1 2-2h2.2a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.9L9 9a14 14 0 0 0 6 6l1.4-1.1a2 2 0 0 1 1.9-.6l3 .5a2 2 0 0 1 1.7 2Z"/></svg>
        </a>
        <% } %>
      </div>
    </div>

    <div>
      <h4>Navegação</h4>
      <a href="/agendar">Agendar horário</a>
      <a href="/minha-conta">Minha conta</a>
      <a href="/#servicos">Serviços</a>
      <a href="/#equipe">Equipe</a>
      <a href="/privacidade">Privacidade</a>
    </div>

    <div>
      <h4>Contato</h4>
      <% if (temCfg) { %>
        <p><%= configuracao.endereco %></p>
        <% if (configuracao.telefone_whatsapp) { %>
          <p>WhatsApp <%= configuracao.telefone_whatsapp %></p>
        <% } %>
      <% } %>
      <p>Seg&ndash;Sáb, com hora marcada</p>
    </div>
  </div>
  <div class="rodape-base">
    © <%= anoAtual %> <%= nomeBarbearia %>. Todos os direitos reservados.
  </div>
</footer>
